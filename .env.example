# Session Secret Key for signed, tamper-proof session cookies (SessionMiddleware)
# In production, replace this with a secure random key: e.g. python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=edith_dev_secret_key_2026_accenture_innovation_track3

# Google Gemini API Key (Optional)
# If provided, activates live generative reasoning via Gemini 2.0 Flash with function calling.
# If omitted or empty, EDITH operates in 100% deterministic offline mode with zero hallucinations.
GEMINI_API_KEY=

# Server Port (default: 8000 / 8501)
PORT=8000
